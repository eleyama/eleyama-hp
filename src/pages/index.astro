---
import { get } from 'node:https';
import '../styles/global.css';

// noteの記事一覧。ビルド時にRSSから取得し、取得できなくてもビルドは止めない
const NOTE_URL = 'https://note.com/eleyama';
const NOTE_LIMIT = 5;

const decode = (text) => text
  .replace(/^<!\[CDATA\[([\s\S]*)\]\]>$/, '$1')
  .replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'").replace(/&amp;/g, '&')
  .trim();

const tag = (item, name) => decode(item.match(new RegExp(`<${name}>([\\s\\S]*?)</${name}>`))?.[1] ?? '');

// fetch ではなく node:https を使う（Windows の Node 24 で fetch 後にビルドが異常終了するため）
const download = (url) => new Promise((resolve, reject) => {
  const req = get(url, { timeout: 10000 }, (res) => {
    if (res.statusCode !== 200) {
      res.resume();
      reject(new Error(`HTTP ${res.statusCode}`));
      return;
    }
    res.setEncoding('utf8');
    let body = '';
    res.on('data', (chunk) => { body += chunk; });
    res.on('end', () => resolve(body));
  });
  req.on('timeout', () => req.destroy(new Error('timeout')));
  req.on('error', reject);
});

async function loadNotes() {
  try {
    const xml = await download(`${NOTE_URL}/rss`);
    return [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)]
      .map(([, item]) => ({ title: tag(item, 'title'), link: tag(item, 'link'), date: new Date(tag(item, 'pubDate')) }))
      .filter((note) => note.title && note.link.startsWith(`${NOTE_URL}/n/`) && !Number.isNaN(note.date.getTime()))
      .sort((a, b) => b.date - a.date)
      .slice(0, NOTE_LIMIT);
  } catch {
    return [];
  }
}

const notes = await loadNotes();
const formatDate = (date) => date.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' });
